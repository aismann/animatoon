+- (void)setTextVerticalAlignment:(ax::TextVAlignment)alignment
+{
+    // UITextField supports contentVerticalAlignment directly. UITextView (multi-line) is top aligned by
+    // design; its vertical placement is handled by the text container inset in a follow-up if needed.
+    if ([self.textInput isKindOfClass:[UITextField class]])
+    {
+        UITextField* field = (UITextField*)self.textInput;
+        switch (alignment)
+        {
+        case ax::TextVAlignment::TOP:
+            field.contentVerticalAlignment = UIControlContentVerticalAlignmentTop;
+            break;
+        case ax::TextVAlignment::BOTTOM:
+            field.contentVerticalAlignment = UIControlContentVerticalAlignmentBottom;
+            break;
+        default:
+            field.contentVerticalAlignment = UIControlContentVerticalAlignmentCenter;
+            break;
+        }
+    }
+}
